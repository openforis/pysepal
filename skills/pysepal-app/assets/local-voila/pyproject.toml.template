[build-system]
requires = ["setuptools>=61.2", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{project_slug}}"
version = "0.1.0"
description = "{{project_description}}"
requires-python = ">=3.12"
dependencies = [
    # Needs ipyvuetify 3; SEPAL's Voila serves the widget frontend from this environment.
    # Before the pysepal 5.0 release, use
    # "pysepal @ git+https://github.com/openforis/pysepal@feat/layer-system" instead.
    "pysepal>=5",
    "solara",
    "voila",
]

[project.optional-dependencies]
dev = [
    "pre-commit>=3.2",
    "commitizen",
    "pytest",
    "pytest-cov",
    "black",
    "ruff",
]

[tool.commitizen]
version = "0.1.0"
update_changelog_on_bump = true
changelog_file = "CHANGELOG.md"
changelog_incremental = true
version_files = [
    "pyproject.toml:version",
]

[tool.pytest.ini_options]
addopts = [
    "--import-mode=importlib",
]
pythonpath = ["."]

[tool.ruff]
fix = true

[tool.ruff.lint]
select = ["E", "F", "W", "I", "D", "RUF"]
ignore = ["E501", "F403", "D107", "D100", "D101", "D102", "D103", "D104"]

[tool.ruff.lint.flake8-quotes]
docstring-quotes = "double"

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.black]
line-length = 100
target-version = ["py312"]
